// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  MANAGER
  SUPER
  SUPPORT_SUPER
  SUPER_CR
  HEAD
  SUPPORT_HEAD
  EVALUATOR
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum PeriodStatus {
  DRAFT
  ACTIVE
  LOCKED
  CLOSED
}

enum PeriodType {
  DAILY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum AssignmentType {
  EMPLOYEE
  DEPARTMENT
  TEAM
}

enum AssignmentSource {
  AUTO
  MANUAL
  LEGACY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  RESET_PASSWORD
  CHANGE_PASSWORD
  SUBMIT_EVALUATION
  LOCK_PERIOD
  UNLOCK_PERIOD
  OVERRIDE
  DISABLE
  ENABLE
}

// ==========================================
// USERS
// ==========================================

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  role               Role      @default(EVALUATOR)
  departmentId       String?   @map("department_id")
  teamId             String?   @map("team_id")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  department           Department?                @relation(fields: [departmentId], references: [id])
  team                 Team?                      @relation(fields: [teamId], references: [id])
  evaluatorAssignments EvaluatorAssignment[]
  periodSelections     PeriodEvaluatorSelection[]
  evaluationRecords    EvaluationRecord[]
  auditLogs            AuditLog[]

  @@index([username])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ==========================================
// DEPARTMENTS
// ==========================================

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  teams                Team[]
  employees            Employee[]
  users                User[]
  evaluatorAssignments EvaluatorAssignment[]

  @@index([isActive])
  @@map("departments")
}

// ==========================================
// TEAMS
// ==========================================

model Team {
  id           String    @id @default(cuid())
  departmentId String    @map("department_id")
  name         String
  code         String    @unique
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department           Department            @relation(fields: [departmentId], references: [id])
  employees            Employee[]
  users                User[]
  evaluatorAssignments EvaluatorAssignment[]

  @@index([departmentId])
  @@index([isActive])
  @@map("teams")
}

// ==========================================
// EMPLOYEES
// ==========================================

model Employee {
  id           String    @id @default(cuid())
  employeeCode String    @unique @map("employee_code")
  name         String
  nickname     String?
  departmentId String    @map("department_id")
  teamId       String?   @map("team_id")
  position     String?
  status       String    @default("active")
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  department           Department            @relation(fields: [departmentId], references: [id])
  team                 Team?                 @relation(fields: [teamId], references: [id])
  evaluatorAssignments EvaluatorAssignment[]
  evaluationRecords    EvaluationRecord[]

  @@index([employeeCode])
  @@index([departmentId])
  @@index([teamId])
  @@index([status])
  @@map("employees")
}

// ==========================================
// EVALUATION PERIODS
// ==========================================

model EvaluationPeriod {
  id                  String       @id @default(cuid())
  name                String
  type                PeriodType   @default(MONTHLY)
  startDate           DateTime     @map("start_date")
  endDate             DateTime     @map("end_date")
  expectedWorkingDays Int          @default(0) @map("expected_working_days")
  status              PeriodStatus @default(DRAFT)
  ruleSetId           String?      @map("rule_set_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  workingDayConfigs    WorkingDayConfig[]
  evaluatorAssignments EvaluatorAssignment[]
  evaluatorSelections  PeriodEvaluatorSelection[]
  evaluationRecords    EvaluationRecord[]
  ruleSet              EvaluationRuleSet?         @relation(fields: [ruleSetId], references: [id])

  @@index([status])
  @@index([startDate, endDate])
  @@map("evaluation_periods")
}

// ==========================================
// CONFIGURABLE EVALUATION RULES
// ==========================================

model EvaluationRuleSet {
  id          String   @id @default(cuid())
  name        String
  version     Int      @default(1)
  totalPoints Decimal  @default(15) @map("total_points") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rules   EvaluationRule[]
  periods EvaluationPeriod[]

  @@unique([name, version])
  @@index([isActive])
  @@map("evaluation_rule_sets")
}

model EvaluationRule {
  id             String   @id @default(cuid())
  ruleSetId      String   @map("rule_set_id")
  code           String
  targetGroup    String   @map("target_group")
  evaluatorRole  Role     @map("evaluator_role")
  evaluatorScope String   @map("evaluator_scope")
  categoryId     String?  @map("category_id")
  weightPoints   Decimal  @default(0) @map("weight_points") @db.Decimal(5, 2)
  selectionMode  String   @default("AUTO") @map("selection_mode")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ruleSet     EvaluationRuleSet     @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  category    EvaluationCategory?   @relation(fields: [categoryId], references: [id])
  assignments EvaluatorAssignment[]

  @@unique([ruleSetId, code])
  @@index([ruleSetId])
  @@index([targetGroup])
  @@map("evaluation_rules")
}

model PeriodEvaluatorSelection {
  id              String   @id @default(cuid())
  periodId        String   @map("period_id")
  slotKey         String   @map("slot_key")
  evaluatorUserId String   @map("evaluator_user_id")
  mainTeamKey     String?  @map("main_team_key")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  period        EvaluationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  evaluatorUser User             @relation(fields: [evaluatorUserId], references: [id])

  @@unique([periodId, slotKey])
  @@index([periodId])
  @@index([evaluatorUserId])
  @@map("period_evaluator_selections")
}

// ==========================================
// WORKING DAY CONFIG
// ==========================================

model WorkingDayConfig {
  id           String   @id @default(cuid())
  periodId     String   @map("period_id")
  date         DateTime @db.Date
  isWorkingDay Boolean  @default(true) @map("is_working_day")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  period EvaluationPeriod @relation(fields: [periodId], references: [id])

  @@unique([periodId, date])
  @@index([periodId])
  @@map("working_day_configs")
}

// ==========================================
// EVALUATION CATEGORIES
// ==========================================

model EvaluationCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  questions            EvaluationQuestion[]
  evaluatorAssignments EvaluatorAssignment[]
  evaluationRules      EvaluationRule[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("evaluation_categories")
}

// ==========================================
// EVALUATION QUESTIONS
// ==========================================

model EvaluationQuestion {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  text        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category         EvaluationCategory @relation(fields: [categoryId], references: [id])
  evaluationScores EvaluationScore[]

  @@index([categoryId])
  @@index([isActive])
  @@map("evaluation_questions")
}

// ==========================================
// SCORE SCALES (Flexible, not hardcoded 1-5)
// ==========================================

model ScoreScale {
  id        String   @id @default(cuid())
  name      String
  minScore  Int      @map("min_score")
  maxScore  Int      @map("max_score")
  isActive  Boolean  @default(true) @map("is_active")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  labels ScoreScaleLabel[]

  @@map("score_scales")
}

model ScoreScaleLabel {
  id          String  @id @default(cuid())
  scaleId     String  @map("scale_id")
  scoreValue  Int     @map("score_value")
  label       String
  description String?

  scale ScoreScale @relation(fields: [scaleId], references: [id])

  @@unique([scaleId, scoreValue])
  @@map("score_scale_labels")
}

// ==========================================
// GRADE CONFIGURATIONS
// ==========================================

model GradeConfig {
  id            String   @id @default(cuid())
  name          String
  label         String
  minPercentage Decimal  @map("min_percentage") @db.Decimal(5, 2)
  maxPercentage Decimal  @map("max_percentage") @db.Decimal(5, 2)
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("grade_configs")
}

// ==========================================
// EVALUATOR ASSIGNMENTS
// Supports: by Employee, by Department, by Team
// ==========================================

model EvaluatorAssignment {
  id                 String           @id @default(cuid())
  evaluatorUserId    String           @map("evaluator_user_id")
  assignmentType     AssignmentType   @map("assignment_type")
  targetEmployeeId   String?          @map("target_employee_id")
  targetDepartmentId String?          @map("target_department_id")
  targetTeamId       String?          @map("target_team_id")
  periodId           String?          @map("period_id")
  categoryId         String?          @map("category_id")
  ruleId             String?          @map("rule_id")
  source             AssignmentSource @default(MANUAL)
  weightPoints       Decimal?         @map("weight_points") @db.Decimal(5, 2)
  weightPercentage   Decimal          @default(0) @map("weight_percentage") @db.Decimal(5, 2)
  assignmentKey      String?          @unique @map("assignment_key")
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  evaluatorUser    User                @relation(fields: [evaluatorUserId], references: [id])
  targetEmployee   Employee?           @relation(fields: [targetEmployeeId], references: [id])
  targetDepartment Department?         @relation(fields: [targetDepartmentId], references: [id])
  targetTeam       Team?               @relation(fields: [targetTeamId], references: [id])
  period           EvaluationPeriod?   @relation(fields: [periodId], references: [id])
  category         EvaluationCategory? @relation(fields: [categoryId], references: [id])
  rule             EvaluationRule?     @relation(fields: [ruleId], references: [id])

  @@index([evaluatorUserId])
  @@index([targetEmployeeId])
  @@index([targetDepartmentId])
  @@index([targetTeamId])
  @@index([periodId])
  @@index([categoryId])
  @@map("evaluator_assignments")
}

// ==========================================
// EVALUATION RECORDS
// One record = one evaluator evaluating one employee for a date range
// ==========================================

model EvaluationRecord {
  id               String           @id @default(cuid())
  periodId         String           @map("period_id")
  employeeId       String           @map("employee_id")
  evaluatorUserId  String           @map("evaluator_user_id")
  evalStartDate    DateTime         @map("eval_start_date") @db.Date
  evalEndDate      DateTime         @map("eval_end_date") @db.Date
  workingDaysCount Int              @default(0) @map("working_days_count")
  status           EvaluationStatus @default(DRAFT)
  comment          String?
  rawScore         Decimal?         @map("raw_score") @db.Decimal(8, 4)
  weightedScore    Decimal?         @map("weighted_score") @db.Decimal(8, 4)
  finalPercentage  Decimal?         @map("final_percentage") @db.Decimal(5, 2)
  workScore        Decimal?         @map("work_score") @db.Decimal(8, 2)
  behaviorScore    Decimal?         @map("behavior_score") @db.Decimal(8, 2)
  supervisorScore  Decimal?         @map("supervisor_score") @db.Decimal(8, 2)
  totalScore       Decimal?         @map("total_score") @db.Decimal(8, 2)
  grade            String?
  isOverride       Boolean          @default(false) @map("is_override")
  overrideReason   String?          @map("override_reason")
  overriddenBy     String?          @map("overridden_by")
  submittedAt      DateTime?        @map("submitted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  period        EvaluationPeriod  @relation(fields: [periodId], references: [id])
  employee      Employee          @relation(fields: [employeeId], references: [id])
  evaluatorUser User              @relation(fields: [evaluatorUserId], references: [id])
  scores        EvaluationScore[]

  @@index([periodId])
  @@index([employeeId])
  @@index([evaluatorUserId])
  @@index([status])
  @@index([evalStartDate, evalEndDate])
  @@map("evaluation_records")
}

// ==========================================
// EVALUATION SCORES (per question per record)
// ==========================================

model EvaluationScore {
  id         String   @id @default(cuid())
  recordId   String   @map("record_id")
  questionId String   @map("question_id")
  scoreValue Int      @map("score_value")
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  record   EvaluationRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  question EvaluationQuestion @relation(fields: [questionId], references: [id])

  @@unique([recordId, questionId])
  @@index([recordId])
  @@index([questionId])
  @@map("evaluation_scores")
}

// ==========================================
// AUDIT LOGS
// Immutable — no update/delete via API
// ==========================================

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  reason     String?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
